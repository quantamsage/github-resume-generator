# Copy to .env (in the directory you start the server from) and fill in values.
# Real environment variables take precedence over this file.

# --- Claude API (optional; without it the app builds facts-only drafts) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# AI_TIMEOUT=180s

# --- GitHub (optional; raises the rate limit from 60 to 5,000 requests/hour) ---
# Use a fine-grained token with no extra permissions (public data only).
# GITHUB_TOKEN=your-github-token-here
# GITHUB_TIMEOUT=15s

# --- Server ---
# ADDR=:8080
# LOG_LEVEL=info                   # debug | info | warn | error
# TRUST_PROXY=false                # set true only behind a reverse proxy that sets X-Forwarded-For

# --- Limits ---
# MAX_REPOS=30                     # repositories listed for selection
# MAX_SELECTED_REPOS=8             # repositories analyzed per resume
# MAX_README_CHARS=6000            # README characters sent per repository
# RATE_LIMIT_PER_MINUTE=30         # per client IP, for analyze/generate/pdf
# MAX_CONCURRENT_GENERATIONS=4
